# Safe environment-variable template for Bird Watching Community.
# Copy this file to .env for local development, then replace the placeholders.
# On Render, set these values in Dashboard -> your service -> Environment.
# Never commit .env or place the service-role key in frontend JavaScript.

# Supabase project URL (safe to expose, but keep privileged keys secret)
SUPABASE_URL=https://tsauwjhulpnzqxqwuxzf.supabase.co
SUPABASE_SERVICE_ROLE_KEY=REPLACE_WITH_SUPABASE_SERVICE_ROLE_KEY
SUPABASE_STORAGE_BUCKET=bird-images

# Hosted database engine: sql (SQLite) or supabase
DB_TYPE=supabase

# Admin panel credentials: replace the placeholder with a strong unique password
ADMIN_USERNAME=admin
ADMIN_PASSWORD=REPLACE_WITH_A_STRONG_UNIQUE_ADMIN_PASSWORD

# Flask session signing secret: use a long, random, private value
SECRET_KEY=REPLACE_WITH_A_LONG_RANDOM_SECRET

# Cross-site frontend/backend session settings for the deployed Netlify frontend
SESSION_COOKIE_SECURE=true
SESSION_COOKIE_SAMESITE=None
FRONTEND_ORIGIN=https://birdwatchingelectroniclog.netlify.app

# Persistent data directory used by the Render disk configuration in render.yaml
BIRDLOG_DATA_DIR=/opt/render/project/src/data
